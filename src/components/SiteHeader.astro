---
const { backHref = '/', backLabel = '手記' } = Astro.props;
---

<header class="site-header">
  <a class="site-home" href={backHref} aria-label={`回${backLabel}`}>← <span>{backLabel}</span></a>
  <div class="reader-controls" aria-label="閱讀設定">
    <button type="button" data-scale="-0.05" aria-label="縮小字體">字−</button>
    <span data-scale-output aria-live="polite">100%</span>
    <button type="button" data-scale="0.05" aria-label="放大字體">字＋</button>
    <button type="button" data-theme-toggle aria-label="切換明暗外觀">◐</button>
  </div>
</header>
