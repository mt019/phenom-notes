---
import SiteHeader from './SiteHeader.astro';
import PostNav from './PostNav.astro';
const { title, subtitle, meta, currentSlug } = Astro.props;
---

<main id="main-content" class="reading-shell">
  <SiteHeader />
  <div class="article-grid">
    <aside class="desktop-nav"><PostNav currentSlug={currentSlug} /></aside>
    <article class="article">
      <header class="article-heading">
        <a class="eyebrow" href="/">手記</a>
        <h1>{title}</h1>
        {subtitle && <p class="subtitle">{subtitle}</p>}
        {meta && <p class="article-meta">{meta}</p>}
      </header>
      <details class="mobile-nav">
        <summary>全部文章</summary>
        <PostNav currentSlug={currentSlug} />
      </details>
      <slot />
    </article>
  </div>
</main>
