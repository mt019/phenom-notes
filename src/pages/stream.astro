---
import BaseLayout from '../layouts/BaseLayout.astro';
import ArticleShell from '../components/ArticleShell.astro';
import { absoluteUrl, linkify, SITE_URL, stream } from '../lib/content.mjs';

const from = stream.dateRange.from.slice(0, 10);
const to = stream.dateRange.to.slice(0, 10);
const description = `${stream.count} 則一句話長度的隨手紀錄，每則保留說出來的時刻，由新到舊按月份與日期排列。`;
---

<BaseLayout
  title="短記｜手記｜Phenom Canvas Lab"
  description={description}
  keywords={['短記', '微網誌', '隨手筆記', '日常紀錄', '時間戳', '手記']}
  canonicalPath="/stream"
  schema={{
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    '@id': `${absoluteUrl('/stream')}#collection`,
    url: absoluteUrl('/stream'),
    name: '短記',
    description,
    temporalCoverage: `${from}/${to}`,
    isPartOf: { '@id': `${SITE_URL}/#blog` },
  }}
>
  <ArticleShell
    title="短記"
    subtitle="一句話一則，說的當下就記下來。不成篇，也不修飾。"
    meta={`${stream.count} 則 · ${from} 至 ${to}`}
  >
    <div class="stream">
      {stream.months.map((month) => (
        <section class="stream-month">
          <h2 id={month.id}>{month.label}</h2>
          {month.days.map((day) => (
            <div>
              <div class="day-divider"><span></span><time>{day.label}</time><span></span></div>
              {day.items.map((item) => (
                <article class="stream-entry" id={item.id}>
                  <a class="stream-time" href={`#${item.id}`} aria-label={`${item.time} 這一則的連結`}>{item.time}</a>
                  <div>
                    {item.paras.map((para) => <p set:html={linkify(para)} />)}
                    {(item.images ?? []).map((image) => (
                      <img src={image.src} alt={image.alt} loading="lazy" />
                    ))}
                  </div>
                </article>
              ))}
            </div>
          ))}
        </section>
      ))}
    </div>
  </ArticleShell>
</BaseLayout>
