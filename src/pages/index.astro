---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import { archive, groupPostsByYear, notes, publicPath, SITE_URL, stream } from '../lib/content.mjs';

const groups = groupPostsByYear(notes.posts);
const description = notes.site.intro;
---

<BaseLayout
  title="手記｜聽講、讀書與整理資料時寫下的短文｜Phenom Canvas Lab"
  description={description}
  keywords={['手記', '演講筆記', '讀後記', '法律制度觀察', '法實證研究']}
  canonicalPath="/"
  schema={{
    '@context': 'https://schema.org',
    '@type': 'Blog',
    '@id': `${SITE_URL}/#blog`,
    url: SITE_URL,
    name: '手記',
    description,
    inLanguage: 'zh-Hant-TW',
  }}
>
  <main id="main-content" class="home-shell">
    <SiteHeader backHref="https://phenomcanvas.com" backLabel="Phenom" />
    <header class="home-heading">
      <p class="eyebrow">NOTES</p>
      <h1>{notes.site.title}</h1>
      <p>{notes.site.intro}</p>
    </header>

    <a class="stream-card" href={publicPath('/stream')}>
      <span class="stream-card-title">短記 <b>{stream.count}</b></span>
      <span class="stream-latest"><time>{stream.latest.date} {stream.latest.time}</time>{stream.latest.text}</span>
    </a>

    <div class="tag-filter">
      <label for="tag">標籤</label>
      <select id="tag" data-tag-filter>
        <option value="all">全部（{notes.posts.length}）</option>
        {notes.tags.map((tag) => <option value={tag.label}>{tag.label}（{tag.count}）</option>)}
      </select>
      <span data-filter-result></span>
    </div>

    <div data-post-groups>
      {groups.map((group) => (
        <section class="year-section" data-year={group.year}>
          <h2>{group.year}</h2>
          <div>
            {group.posts.map((post) => (
              <a class="post-row" href={publicPath(post.route)} data-post data-tags={(post.tags ?? []).join('\u001f')}>
                <div class="post-title-line">
                  <h3>{post.title}</h3><span aria-hidden="true">→</span>
                </div>
                {post.subtitle && <p class="post-subtitle">{post.subtitle}</p>}
                <p class="post-summary">{post.summary}</p>
                <p class="post-meta">
                  <time datetime={post.publishedAt}>{post.publishedAt}</time>
                  {post.readingMinutes && ` · 約 ${post.readingMinutes} 分鐘`}
                  {(post.tags ?? []).length > 0 && ` · ${post.tags.join('、')}`}
                </p>
              </a>
            ))}
          </div>
        </section>
      ))}
    </div>

    <a class="archive-card" href={publicPath('/archive')}>
      <strong>舊帖 <b>{archive.count}</b></strong>
      <span>{archive.dateRange.from.slice(0, 4)}–{archive.dateRange.to.slice(0, 4)} 年的短記，按年份收在同一頁。</span>
    </a>
    <p class="site-note">{notes.site.note}</p>
  </main>
</BaseLayout>
