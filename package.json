{
  "name": "phenom-notes",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "data:local": "node scripts/export-local-data.mjs",
    "prebuild": "node scripts/prepare-build.mjs",
    "build": "vite build && vite build --ssr src/entry-server.jsx --outDir .ssr && node scripts/render-static.mjs && node scripts/write-deployment-manifest.mjs && node scripts/validate-build.mjs && node scripts/stage-pages.mjs",
    "dev": "node scripts/prepare-build.mjs && vite",
    "preview": "node scripts/serve-preview.mjs",
    "test": "node --test tests/*.test.mjs"
  },
  "engines": {
    "node": ">=22 <23"
  },
  "dependencies": {
    "@phenomcanvas/ui": "https://github.com/mt019/phenom-ui/archive/refs/tags/v0.1.22.tar.gz",
    "@mdx-js/react": "3.1.1",
    "github-slugger": "2.0.0",
    "katex": "0.17.0",
    "lucide-react": "0.468.0",
    "marked": "16.4.2",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "6.30.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "4.3.4",
    "autoprefixer": "10.4.20",
    "postcss": "8.4.49",
    "tailwindcss": "3.4.17",
    "vite": "5.4.14"
  }
}
